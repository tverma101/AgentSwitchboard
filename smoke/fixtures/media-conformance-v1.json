{
  "schema": "fcc.media-conformance.v1",
  "payload_policy": "metadata-only; image bytes and source payloads are omitted",
  "receipt_contract": {
    "required_fields": ["media_count", "media_type_hash"],
    "media_count_semantics": "before_and_after_conversion",
    "hash_input": "ordered block type and declared media type",
    "payload_free": true,
    "forbidden_keys": [
      "base64",
      "bytes",
      "content",
      "data",
      "image_bytes",
      "payload",
      "prompt",
      "response",
      "source_data",
      "tool_arguments"
    ]
  },
  "invariants": {
    "source_order": "preserve_on_success",
    "zero_media_after_conversion": "typed_reject",
    "unsupported_media_route": "reject_before_upstream",
    "tool_result_association": "tool_use_id",
    "retry_side_effects": "at_most_one_per_logical_request"
  },
  "cases": [
    {
      "id": "single-png-base64",
      "location": "user_message",
      "source": "base64",
      "media_type": "image/png",
      "expected": "preserve_or_typed_reject",
      "protocols": ["anthropic_messages", "openai_chat", "openai_responses"],
      "golden": {
        "media_count": 1,
        "ordered_media_types": ["image/png"],
        "source_order": "preserve_on_success",
        "association": "none"
      }
    },
    {
      "id": "single-jpeg-base64",
      "location": "user_message",
      "source": "base64",
      "media_type": "image/jpeg",
      "expected": "preserve_or_typed_reject",
      "protocols": ["anthropic_messages", "openai_chat", "openai_responses"],
      "golden": {
        "media_count": 1,
        "ordered_media_types": ["image/jpeg"],
        "source_order": "preserve_on_success",
        "association": "none"
      }
    },
    {
      "id": "single-webp-base64",
      "location": "user_message",
      "source": "base64",
      "media_type": "image/webp",
      "expected": "preserve_or_typed_reject",
      "protocols": ["anthropic_messages", "openai_chat", "openai_responses"],
      "golden": {
        "media_count": 1,
        "ordered_media_types": ["image/webp"],
        "source_order": "preserve_on_success",
        "association": "none"
      }
    },
    {
      "id": "url-image",
      "location": "user_message",
      "source": "url",
      "media_type": "image/jpeg",
      "expected": "preserve_or_typed_reject",
      "protocols": ["openai_chat", "openai_responses"],
      "golden": {
        "media_count": 1,
        "ordered_media_types": ["image/jpeg"],
        "source_order": "preserve_on_success",
        "association": "none"
      }
    },
    {
      "id": "interleaved-multiple-images",
      "location": "user_message",
      "source": "mixed",
      "media_type": "image/png,image/webp",
      "expected": "preserve_order_or_typed_reject",
      "protocols": ["anthropic_messages", "openai_chat", "openai_responses"],
      "golden": {
        "media_count": 2,
        "ordered_media_types": ["image/png", "image/webp"],
        "source_order": "preserve_on_success",
        "association": "none",
        "interleaved_text": true
      }
    },
    {
      "id": "tool-result-image",
      "location": "tool_result",
      "source": "base64",
      "media_type": "image/png",
      "expected": "preserve_association_or_typed_reject",
